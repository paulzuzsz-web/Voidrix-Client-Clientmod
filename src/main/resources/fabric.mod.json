{
  "schemaVersion": 1,
  "id": "voidrix",
  "version": "${version}",
  "name": "Voidrix",
  "description": "Clientseitiger Minecraft-Mod mit HUD-System, Mod-Menue, PvP- und Optik-Modulen. Laeuft auf jedem Server, ohne dort installiert zu sein.",
  "authors": [
    "Voidrix"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/voidrix/icon.png",

  "environment": "client",

  "entrypoints": {
    "client": [
      "gg.voidrix.client.VoidrixClient"
    ]
  },

  "mixins": [
    {
      "config": "voidrix.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=26.2",
    "java": ">=25"
  }
}
